{
    "name": "xmlbeans/php-xmlbeans",
    "description": "PHP port of Apache XMLBeans - XML-Schema-to-PHP binding framework",
    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": ">=7.2",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "XmlBeans\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "XmlBeans\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/scomp"
    ]
}
